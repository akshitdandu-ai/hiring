# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string ->
# "Transaction pooler", port 6543. Neon: the pooled connection string). Tables are created automatically.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google AI Studio key for Gemini (all AI steps: scoring, brief, email drafts)
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash

# Resend (leave blank until checkpoint B-2). Without a verified domain Resend only allows
# onboarding@resend.dev as the sender.
RESEND_API_KEY=
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>
# EMAIL_REPLY_TO=arjun@example.com
# Optional safety nets: only allow these recipient domains / send everything to one test inbox
# EMAIL_ALLOWED_DOMAINS=
# EMAIL_TEST_RECIPIENT=

# Optional: password-protect the dashboard (username can be anything)
DASHBOARD_PASSWORD=

# Optional tuning
# TOP_N_PER_ROLE=5
# INVITE_THRESHOLD=60
# FOUNDER_NAME=Arjun Mehta
# COMPANY_NAME=Kargo
