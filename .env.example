# Shown at the top of every screen (build-time). Defaults to "[TEAM NAME]".
VITE_TEAM_NAME=

# OPTIONAL: LLM field extraction. Off by default; the rule-based parser handles everything without it.
# 1) set to true at build time so the browser calls /api/extract
VITE_ENABLE_LLM=false
# 2) server-side only (Vercel env var). Without it /api/extract returns 501 and the app falls back to rules.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
